---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import QhdVisuals from '../../components/QhdVisuals.astro';
import { formatDate } from '../../lib/posts';
import 'katex/dist/katex.min.css';
export async function getStaticPaths() { return (await getCollection('notes')).map((post) => ({ params: { id: post.id }, props: { post } })); }
interface Props { post: CollectionEntry<'notes'> }
const { post } = Astro.props;
const { Content } = await render(post);
const isQhdNote = post.id === 'quantum-hamiltonian-descent';
---
<SiteLayout title={post.data.title} description={`Notes by Zhiyuan Jia on ${post.data.keywords.join(', ')}.`} article>
  <article class="article-shell">
    <a class="text-link back-link" href="/#notes">← Return</a>
    <header class="article-header"><h1>{post.data.title}</h1>{post.data.subtitle && <p class="article-subtitle">{post.data.subtitle}</p>}<div class="article-meta"><span>Zhiyuan Jia</span><time datetime={post.data.date.toISOString()}>{post.data.dateLabel ?? formatDate(post.data.date)}</time></div><div class="tags">{post.data.keywords.map((keyword) => <span>{keyword}</span>)}{post.data.highlight && <span class="result-tag">{post.data.highlight}</span>}</div></header>
    <div class="prose"><Content />{isQhdNote && <QhdVisuals />}</div>
  </article>
</SiteLayout>
